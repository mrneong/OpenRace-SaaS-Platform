/**
 * OpenRace Server Entry Point (TypeScript)
 * Boots Fullstack Dual-Server:
 * - Port 3001: NestJS API & Strava Webhook Gateway
 * - Port 3000: Modern Clean SaaS Dashboard (Image Ref UI/UX)
 */

import * as http from 'http';
import { InMemoryDataStore } from './infrastructure/repositories/in-memory-data.store';
import { WebhookIngestionUseCase } from './application/use-cases/webhook-ingestion.use-case';
import { AppealsUseCase } from './application/use-cases/appeals.use-case';
import { AdminManagementUseCase } from './application/use-cases/admin-management.use-case';
import { RunnerDashboardUseCase } from './application/use-cases/runner-dashboard.use-case';
import { RaceArenaUseCase } from './application/use-cases/race-arena.use-case';
import { ActivityFeedUseCase } from './application/use-cases/activity-feed.use-case';
import { ClubHubUseCase } from './application/use-cases/club-hub.use-case';
import { V2CommunityFeaturesUseCase } from './application/use-cases/v2-community-features.use-case';
import { evaluateActivity } from './domain/rule-engine/rule-engine';
import { getDefaultRuleSet } from './domain/models/models';
import type { Race, Activity } from './domain/models/models';

const API_PORT = process.env.PORT ? parseInt(process.env.PORT, 10) : 3001;
const FRONTEND_PORT = 3000;

function getFrontendHtml(): string {
  return `<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OpenRace SaaS Platform - Dashboard Giải Chạy</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .section-highlight { animation: pulse-ring 1.5s ease-out; }
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(255, 91, 38, 0.6); }
      70% { box-shadow: 0 0 0 10px rgba(255, 91, 38, 0); }
      100% { box-shadow: 0 0 0 0 rgba(255, 91, 38, 0); }
    }
  </style>
</head>
<body class="bg-[#F4F5F7] text-slate-800 min-h-screen flex antialiased">
  <!-- 0. SLIM FLOATING/DOCKED ICON RAIL (EXACT DESIGN MATCH) -->
  <aside id="slim-rail" class="w-16 bg-white border-r border-slate-200/80 flex flex-col items-center justify-between py-5 shrink-0 z-40 h-screen sticky top-0 shadow-[2px_0_10px_rgba(0,0,0,0.02)]">
    <div class="flex flex-col items-center gap-6 w-full">
      <!-- Top Brand Logo -->
      <button onclick="switchTab('dashboard')" class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-500 to-[#FF5B26] flex items-center justify-center text-white shadow-md shadow-orange-500/20 font-black text-xs hover:scale-105 transition" title="OpenRace Home">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </button>

      <!-- Nav Icons Stack -->
      <div class="flex flex-col items-center gap-3.5 w-full px-2">
        <button onclick="switchTab('dashboard')" id="rail-btn-dashboard" class="w-10 h-10 rounded-2xl bg-[#18181B] text-white flex items-center justify-center shadow-sm transition hover:scale-105" title="[1.0] Overview / Runner Hub">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
        </button>
        <button onclick="switchTab('arena')" id="rail-btn-arena" class="w-10 h-10 rounded-2xl text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition" title="[2.0] Đấu Trường">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </button>
        <button onclick="switchTab('activities')" id="rail-btn-activities" class="w-10 h-10 rounded-2xl text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition" title="[3.0] Nhật Ký Hoạt Động">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </button>
        <button onclick="switchTab('club')" id="rail-btn-club" class="w-10 h-10 rounded-2xl text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition" title="[4.0] Không Gian CLB">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </button>
        <button onclick="switchTab('finance')" id="rail-btn-finance" class="w-10 h-10 rounded-2xl text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition" title="[5.0] Cá Nhân & Sổ Nợ">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        </button>
        <button onclick="switchTab('rules')" id="rail-btn-rules" class="w-10 h-10 rounded-2xl text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition" title="[7.0] Điều Hành Giải Đấu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </button>
        <button onclick="switchTab('admin')" id="rail-btn-admin" class="w-10 h-10 rounded-2xl text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition relative" title="[8.0] Super Admin">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-[#FF5B26] animate-pulse"></span>
        </button>
      </div>
    </div>

    <!-- Bottom Help & Orange Pill Indicator -->
    <div class="flex flex-col items-center gap-2">
      <button onclick="toggleSidebar()" class="w-8 h-8 rounded-full text-slate-400 hover:text-rose-500 font-bold text-xs flex items-center justify-center hover:bg-slate-100 transition" title="Mở danh mục đầy đủ [1.0] - [8.0]">
        ?
      </button>
      <div class="w-1.5 h-5 rounded-full bg-[#FF5B26]/80"></div>
    </div>
  </aside>

  <!-- 1. COMPREHENSIVE SIDEBAR WITH EXACT CODES [1.0] -> [8.0] & SUB-MENUS (OFF-CANVAS DRAWER) -->
  <div id="sidebar-backdrop" onclick="toggleSidebar()" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-50 transition-opacity"></div>
  <aside id="main-sidebar" class="fixed inset-y-0 left-16 z-50 w-72 lg:w-80 bg-white/98 backdrop-blur-md rounded-r-3xl p-4 flex flex-col justify-between border-r border-y border-slate-200/80 shadow-2xl transition-all duration-300 -translate-x-[150%] max-h-screen overflow-y-auto no-scrollbar">
    <div class="space-y-4">
      <!-- Top Brand & Theme Toggle -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-[#FF5B26] to-[#FF8254] flex items-center justify-center text-white shadow-md shadow-orange-500/20 font-black text-sm">
            OR
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-base font-black tracking-tight text-slate-900">OpenRace</span>
              <span class="text-[9px] font-extrabold uppercase tracking-widest text-[#FF5B26] bg-orange-50 px-1.5 py-0.5 rounded-full">SaaS</span>
            </div>
            <div class="text-[10px] text-slate-400 font-medium">Menu Hệ Thống v3.0</div>
          </div>
        </div>
        <button onclick="toggleSidebar()" class="w-8 h-8 rounded-xl flex items-center justify-center text-slate-400 hover:bg-slate-100 transition text-xs font-bold" title="Đóng menu">
          ✕
        </button>
      </div>

      <!-- Navigation Tree: 3 Major Sections -->
      <nav class="space-y-4 text-xs">
        <!-- GROUP 1: RUNNER (VẬN ĐỘNG VIÊN) -->
        <div class="space-y-1">
          <div class="px-2 text-[10px] font-extrabold tracking-wider text-slate-400 uppercase flex items-center justify-between">
            <span>VẬN ĐỘNG VIÊN (RUNNER)</span>
            <span class="text-[9px] text-slate-400">1.0 - 5.0</span>
          </div>

          <!-- [1.0] Dashboard Runner -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('dashboard')" id="sidebar-dashboard" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition bg-[#18181B] text-white shadow-sm">
              <div class="flex items-center gap-2">
                <span class="text-sm">⊞</span>
                <span>Tổng Quan Runner</span>
              </div>
              <span class="text-[10px] opacity-70">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-orange-500 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('dashboard', 'section-1-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Đồng bộ Strava</a>
              <a href="javascript:void(0)" onclick="goToSection('dashboard', 'section-1-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Chỉ tiêu tuần</a>
              <a href="javascript:void(0)" onclick="goToSection('dashboard', 'section-1-3')" class="block py-1 text-rose-600 hover:text-rose-700 font-semibold">• Cảnh báo phạt sớm</a>
              <a href="javascript:void(0)" onclick="goToSection('dashboard', 'section-1-4')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Carousel giải đấu</a>
              <a href="javascript:void(0)" onclick="goToSection('dashboard', 'section-1-5')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Lối tắt quét QR / Vào giải</a>
            </div>
          </div>

          <!-- [2.0] Đấu Trường Giải -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('arena')" id="sidebar-arena" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition text-slate-700 hover:bg-slate-100">
              <div class="flex items-center gap-2">
                <span class="text-sm">🏆</span>
                <span>Đấu Trường Giải</span>
              </div>
              <span class="text-[10px] text-slate-400">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-slate-300 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('arena', 'section-2-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Hero & Đếm ngược</a>
              <a href="javascript:void(0)" onclick="goToSection('arena', 'section-2-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Bảng xếp hạng Đội</a>
              <a href="javascript:void(0)" onclick="goToSection('arena', 'section-2-3')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Bảng xếp hạng Cá nhân</a>
              <a href="javascript:void(0)" onclick="goToSection('arena', 'section-2-4')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Đội thi của tôi</a>
              <a href="javascript:void(0)" onclick="goToSection('arena', 'section-2-5')" class="block py-1 text-emerald-600 font-semibold">• Luồng Live Stream SSE</a>
            </div>
          </div>

          <!-- [3.0] Nhật Ký Hoạt Động -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('activities')" id="sidebar-activities" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition text-slate-700 hover:bg-slate-100">
              <div class="flex items-center gap-2">
                <span class="text-sm">📋</span>
                <span>Nhật Ký Bài Chạy</span>
              </div>
              <span class="text-[10px] text-slate-400">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-slate-300 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('activities', 'section-3-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Toàn bộ bài chạy</a>
              <a href="javascript:void(0)" onclick="goToSection('activities', 'section-3-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Lọc theo giải đấu</a>
              <a href="javascript:void(0)" onclick="goToSection('activities', 'section-3-3')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Chi tiết thẩm định & Gain</a>
              <a href="javascript:void(0)" onclick="goToSection('activities', 'section-3-4')" class="block py-1 text-[#FF5B26] font-semibold">• Gửi khiếu nại</a>
            </div>
          </div>

          <!-- [4.0] Không Gian CLB -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('club')" id="sidebar-club" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition text-slate-700 hover:bg-slate-100">
              <div class="flex items-center gap-2">
                <span class="text-sm">👥</span>
                <span>Không Gian CLB</span>
              </div>
              <span class="text-[10px] text-slate-400">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-slate-300 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('club', 'section-4-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Hồ sơ & Bảng tin CLB</a>
              <a href="javascript:void(0)" onclick="goToSection('club', 'section-4-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Danh mục giải CLB</a>
              <a href="javascript:void(0)" onclick="goToSection('club', 'section-4-3')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Thành viên & Ban cán sự</a>
              <a href="javascript:void(0)" onclick="goToSection('club', 'section-4-4')" class="block py-1 text-amber-600 font-semibold">• Mời thành viên (Chống In-App)</a>
            </div>
          </div>

          <!-- [5.0] Cá Nhân & Cài Đặt -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('finance')" id="sidebar-finance" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition text-slate-700 hover:bg-slate-100">
              <div class="flex items-center gap-2">
                <span class="text-sm">💳</span>
                <span>Cá Nhân & Sổ Nợ</span>
              </div>
              <span class="text-[10px] text-slate-400">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-slate-300 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('finance', 'section-5-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Tài khoản & GDPR</a>
              <a href="javascript:void(0)" onclick="goToSection('finance', 'section-5-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Kết nối Strava OAuth</a>
              <a href="javascript:void(0)" onclick="goToSection('finance', 'section-5-3')" class="block py-1 text-emerald-600 font-semibold">• Sổ nợ & Đóng quỹ</a>
              <a href="javascript:void(0)" onclick="goToSection('finance', 'section-5-4')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Tùy chọn giao diện</a>
            </div>
          </div>
        </div>

        <!-- GROUP 2: CLUB ADMIN (BAN QUẢN TRỊ CLB) -->
        <div class="space-y-1 pt-2 border-t border-slate-100">
          <div class="px-2 text-[10px] font-extrabold tracking-wider text-slate-400 uppercase flex items-center justify-between">
            <span>QUẢN TRỊ CLB (CLUB ADMIN)</span>
            <span class="text-[9px] text-slate-400">6.0 - 7.0</span>
          </div>

          <!-- [6.0] Quản Trị CLB -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('club-manage')" id="sidebar-club-manage" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition text-slate-700 hover:bg-slate-100">
              <div class="flex items-center gap-2">
                <span class="text-sm">🏛️</span>
                <span>Quản Trị CLB</span>
              </div>
              <span class="text-[10px] text-slate-400">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-slate-300 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('club-manage', 'section-6-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Cài đặt CLB & VietQR BIN</a>
              <a href="javascript:void(0)" onclick="goToSection('club-manage', 'section-6-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Quản trị thành viên</a>
              <a href="javascript:void(0)" onclick="goToSection('club-manage', 'section-6-3')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Quản lý mã mời</a>
            </div>
          </div>

          <!-- [7.0] Quản Trị Giải Đấu -->
          <div class="rounded-2xl overflow-hidden">
            <button onclick="switchTab('rules')" id="sidebar-rules" class="sidebar-btn w-full p-2.5 rounded-2xl flex items-center justify-between font-bold text-left transition text-slate-700 hover:bg-slate-100">
              <div class="flex items-center gap-2">
                <span class="text-sm">⚙️</span>
                <span>Điều Hành Giải Đấu</span>
              </div>
              <span class="text-[10px] text-slate-400">▾</span>
            </button>
            <div class="pl-6 pr-2 py-1.5 space-y-1 bg-slate-50/70 border-l-2 border-slate-300 ml-3 mt-1 rounded-r-xl text-[11px]">
              <a href="javascript:void(0)" onclick="goToSection('rules', 'section-7-1')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Wizard thể lệ (Khóa 2:45)</a>
              <a href="javascript:void(0)" onclick="goToSection('rules', 'section-7-2')" class="block py-1 text-slate-600 hover:text-[#FF5B26] font-medium">• Phân bổ Đội & Đội trưởng</a>
