{
  "name": "openrace-platform",
  "version": "1.0.0",
  "private": true,
  "description": "OpenRace SaaS Platform Monorepo (Next.js + NestJS)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm run start:dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "next-auth": "^4.24.15"
  }
}
