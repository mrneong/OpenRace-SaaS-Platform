# =================================================================
# OPENRACE SAAS PLATFORM V2.1 CONFIGURATION ENVIRONMENT
# Architecture: Next.js 15 (Frontend) + NestJS (Backend) + Supabase
# =================================================================

# 1. DATABASE & SUPABASE (POSTGRESQL 16)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. CACHING & QUEUE (REDIS 7 & BULLMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. STRAVA API & WEBHOOK GATEWAY
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_VERIFY_TOKEN=openrace_webhook_secret_token_2026
STRAVA_WEBHOOK_CALLBACK_URL=https://api.openrace.app/api/webhooks/strava

# 4. BACKEND API SERVICE (NESTJS)
PORT=3001
NODE_ENV=production
JWT_SECRET=super_secure_openrace_jwt_secret_key_v2_1
CORS_ORIGIN=http://localhost:3000

# 5. FRONTEND WEB CLIENT (NEXT.JS 15)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
